# Server Port
PORT=5000
NODE_ENV=development

# Database Connection (SQLite for local development, PostgreSQL ready for production)
DATABASE_URL="file:./dev.db"

# Allowed CORS origins (comma-separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Admin API Key for protected reservation & menu endpoints
ADMIN_API_KEY="haveli-highway-admin-key-2026"

# Structured Logger Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL="info"

# Rate Limit Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
